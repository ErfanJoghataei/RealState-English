@{
    Layout = null;
}
@using RealState.Dal.Entities

@model User
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account | Edit profile</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="/css/Panell/UserPanell.css" rel="stylesheet" />
</head>
<body>
    <!-- نوار کناری -->
    <aside class="sidebar">
        <a href="/" class="logo">
            <i class="fas fa-building"></i>
            <span>RealState 200</span>
        </a>

        <ul class="sidebar-menu">
            <li><a href="/" class="active"><i class="fas fa-home"></i> Home</a></li>
            <li><a href="#profile"><i class="fas fa-user"></i> Profile</a></li>
            <li><a href="#edit"><i class="fas fa-edit"></i> Edit details</a></li>
            <li><a href="#password"><i class="fas fa-lock"></i> Change password</a></li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <img src="https://ui-avatars.com/api/?name=User&background=d4af37&color=000" alt="User">
                <span>@Model.UserName</span>
            </div>
            <form action="@Url.Action("Logout", "Account")" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">Sign out</button>
            </form>
        </div>
    </aside>

    <!-- محتوای اصلی -->
    <main class="main-content">
        <div class="header">
            <h1>Account | Edit profile</h1>
        </div>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["ModelStateErrors"] != null)
        {
            var errors = TempData["ModelStateErrors"] as List<string>;
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <!-- Details Profile -->
        <div class="content-area" id="profile">
            <h2 class="section-title">
                <i class="fas fa-user"></i>
                Profile details
            </h2>

            <h2 class="profile-name" id="profile-name">@Model.UserName</h2>

            <div class="info-card">
                <h3><i class="fas fa-info-circle"></i> Account details</h3>

                <div class="info-item">
                    <span class="info-label">Username:</span>
                    <span class="info-value" id="info-username">@Model.UserName</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Email:</span>
                    <span class="info-value">@Model.Email</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Phone number:</span>
                    <span class="info-value">@Model.PhoneNumber</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Member since:</span>
                    <span class="info-value">
                        @{
                            string persianDate = Model?.JoneDate != null
                            ? Model.JoneDate.ToPersianDate()
                            : "-";
                        }
                       @persianDate
                    </span>
                </div>
            </div>
        </div>

        <!-- Edit details -->
        <div class="content-area">
            <h2 class="section-title">
                <i class="fas fa-edit"></i>
                Edit profile
            </h2>

            <form id="profile-form" asp-action="UserEdit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="form-grid">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" asp-for="UserName" value="@Model.UserName">
                    </div>
                    <div class="form-group">
                        <label for="email">Email address</label>
                        <input type="email"  asp-for="Email" value="@Model.Email">
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone number</label>
                        <input type="tel" asp-for="PhoneNumber" value="@Model.PhoneNumber">
                    </div>

                </div>

                <div class="form-submit">
                    <button type="submit" class="admin-btn btn-primary">
                        <i class="fas fa-save"></i> Save changes
                    </button>
                </div>
            </form>
        </div>

        <!-- Change password -->
        <div class="content-area">
            <h2 class="section-title">
                <i class="fas fa-lock"></i>
                Change password
            </h2>
            <!-- نمایش Message موفقیت -->

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            <form id="password-form" asp-action="EditPassword" method="post">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="current-password">Current password</label>
                        <input type="password" id="current-password" name="CurrentPassword" required>
                    </div>
                    <div class="form-group">
                        <label for="new-password">New password</label>
                        <input type="password" id="new-password" name="NewPassword" required>
                    </div>
                    <div class="form-group">
                        <label for="confirm-password">Confirm new password</label>
                        <input type="password" id="confirm-password" name="ConfirmPassword" required>
                    </div>
                </div>

                <div class="form-submit">
                    <button type="submit" class="admin-btn btn-primary">
                        <i class="fas fa-key"></i> Change password
                    </button>
                </div>
            </form>


        </div>

        <!-- Security -->
        <div class="content-area">
            <h2 class="section-title">
                <i class="fas fa-shield-alt"></i>
                Security
            </h2>

            <div class="info-card">
             



            <div class="form-submit">
                    <form action="@Url.Action("Logout", "Account")" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="admin-btn btn-danger">
                            <i class="fas fa-sign-out-alt"></i> Sign out
                        </button>
                    </form>
            </div>
        </div>
    </main>


</body>
</html>
