@{
    Layout = null;
}
@model AdminPanelViewModel
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real estate administration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="/css/Panell/AdminPanell.css" rel="stylesheet" />
</head>
<body>
    <!-- نوار کناری -->
    <aside class="sidebar">
        <a href="/" class="logo" onclick="showPage('dashboard')">
            <i class="fas fa-building"></i>
            <span>RealState 200</span>
        </a>

        <ul class="sidebar-menu">
            <li><a href="#" class="active" onclick="showPage('dashboard')"><i class="fas fa-home"></i> Overview</a></li>
            <li><a href="#" onclick="showPage('add-property')"><i class="fas fa-plus-circle"></i> Add property</a></li>
            <li><a href="#" onclick="showPage('manage-properties')"><i class="fas fa-list"></i> Property management</a></li>
            <li><a href="#" onclick="showPage('manage-admins')"><i class="fas fa-users-cog"></i> Manage admins</a></li>
            

        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <img src="https://ui-avatars.com/api/?name=Admin+سیستم&background=d4af37&color=000" alt="Admin">
                <span>System admin</span>
            </div>
            <form asp-action="LogoutAdmin" asp-controller="Panel" method="post">
                <button type="submit" class="logout-btn">Sign out</button>
            </form>
        </div>
    </aside>

    <!-- محتوای اصلی -->
    <main class="main-content">
        <div class="header">
            <h1 id="page-title">Overview</h1>
            <div id="breadcrumb">
                <span>Home</span> / <span>Overview</span>
            </div>
        </div>

        <!-- صفحه Overview -->
        <div id="dashboard" class="page-content active">
            <div class="content-area">
                <h2 class="section-title">Platform overview</h2>

                <div class="form-grid">
                    <div class="form-group">
                        <div class="info-card">
                            <h3><i class="fas fa-home"></i> Total properties</h3>
                            <p class="stat">۱۲۴</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="info-card">
                            <h3><i class="fas fa-users"></i> Active users</h3>
                            <p class="stat">۸۷</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="info-card">
                            <h3><i class="fas fa-users-cog"></i> Admins</h3>
                            <p class="stat">۵</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="info-card">
                            <h3><i class="fas fa-chart-line"></i> Views today</h3>
                            <p class="stat">۲۴۳</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- صفحه Add property -->
        <div id="add-property" class="page-content">
            <div class="content-area">
                <h2 class="section-title">Add property</h2>

                <form id="property-form">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="title">Property title *</label>
                            <input type="text" id="title" name="title" required>
                        </div>
                        <div class="form-group">
                            <label for="price">Price (toman) *</label>
                            <input type="number" id="price" name="price" required>
                        </div>
                        <div class="form-group">
                            <label for="floorArea">Area (m²) *</label>
                            <input type="number" id="floorArea" name="floorArea" required>
                        </div>
                        <div class="form-group">
                            <label for="city">City *</label>
                            <input type="text" id="city" name="city" required>
                        </div>
                    </div>

                    <div class="form-submit">
                        <button type="submit" class="admin-btn btn-primary">
                            <i class="fas fa-save"></i> Save property
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- صفحه Property management -->
        <div id="manage-properties" class="page-content">
            <div class="content-area">
                <h2 class="section-title">Property list</h2>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Title</th>
                        
                            <th>Price</th>
                            <th>Deposit</th>
                            <th>Rent</th>
                            <th>City</th>
                     
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prop in Model.Properties)
                        {
                            <tr>
                                <td>@prop.Code</td>
                                <td>@prop.Title</td>
                                <td>@(prop.Price?.ToString() ?? "Empty" )</td>
                                <td>@(prop.FirstMoney?.ToString() ?? "Empty" )</td>
                                <td>@(prop.MoneyRent?.ToString() ?? "Empty" )</td>
                                <td>@prop.city</td>
                           
                                <td class="action-buttons">
                                    <button class="btn-edit"><i class="fas fa-edit"></i></button>
                                    <a asp-action="RemoveProperty" , asp-controller="Panel" , asp-route-code="@prop.Code" style="text-decoration:none;">
                                        <button class="btn-delete"><i class="fas fa-trash"></i></button>
                                    </a>
                             
                                </td>
                            </tr>
                        } 

             
                    </tbody>
                </table>
            </div>
        </div>

        <!-- صفحه Manage admins -->
        <div id="manage-admins" class="page-content">
            <div class="content-area">
                

                <!-- فرم افزودن ادمین -->
                <div id="admin-form" class="form-container" style="margin-top: 20px;">
                    <h3 class="section-title">Add admin</h3>
                    @using (Html.BeginForm("AddAdmin", "Panel", FormMethod.Post, new { id = "add-admin-form" }))
                    {
                        @Html.AntiForgeryToken()
                        ;
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="form-grid">

                            <div class="form-group">
                                <label for="admin-username">Username *</label>
                                <input type="text" id="admin-username" name="UserName" required>
                                    </div>
                                <div class="form-group">
                                    <label for="admin-password">Password *</label>
                                    <input type="password" id="admin-password" name="Password" required>
                                    </div>
                                </div>

                                <div class="form-submit">
                                    <button type="submit" class="admin-btn btn-primary" style="margin-bottom:10px;">
                                        <i class="fas fa-save"></i> Save admin
                                    </button>
                                </div>
                            }

                    
                        </div>


                            <!-- فرم Edit admin -->
                            <div id="edit-admin-modal" class="modal-overlay" aria-hidden="true">
                                <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="edit-admin-title">
                                    <button type="button" class="modal-close" onclick="closeEditAdminModal()" aria-label="Close">
                                        <i class="fas fa-times"></i>
                                    </button>
                                    <h3 id="edit-admin-title" class="section-title">Edit admin</h3>
                                    @using (Html.BeginForm("EditAdmin", "Panel", FormMethod.Post, new { id = "edit-admin-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                    <div class="form-grid">
                                        <input type="hidden" id="edit-admin-id" name="Id" required>
                                        <div class="form-group">
                                            <label for="edit-admin-username">Username</label>
                                            <input type="text" id="edit-admin-username" name="UserName" required>
                                        </div>
                                        <div class="form-group">
                                            <label for="edit-admin-password">Password</label>
                                            <input type="password" id="edit-admin-password" name="Password" required>
                                        </div>
                                    </div>

                                    <div class="form-submit">
                                        <button type="submit" class="admin-btn btn-primary">
                                            <i class="fas fa-edit"></i> Update admin
                                        </button>
                                    </div>
                        
                                            }

                                </div>
                            </div>

                                        <!-- Admin list -->
                                        @* <h3 class="section-title" style="margin-top: 30px;">Admin list</h3> *@
                                        <div class="page-content.active">
                                            <div class="content-area">
                                                <h3 class="section-title">Admin list</h3>

        
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                       
                                                            <th>Username</th>
                                                            <th>Actions</th>
                                  
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var admin in Model.Admins)
                                                        {
                                                            <tr>
                                                            
                                                                <td>@admin.UserName</td>
                                                                <td>
                                                                    <button type="button"
                                                                            class="btn-edit"
                                                                            onclick="openEditAdminModal(this)"
                                                                            data-admin-id="@admin.Id"
                                                                            data-admin-username="@admin.UserName"
                                                                            data-admin-password="@admin.Password">
                                                                        <i class="fas fa-edit"></i>
                                                                    </button>
                                                                </td>
                                                                <td> 
                                                                    <form asp-action="RemoveAdmin" asp-controller="Panel" method="post" asp-route-id="@admin.Id" style="text-decoration:none;">
                                                                        <button type="submit" class="btn-delete"><i class="fas fa-trash"></i></button>
                                                                    </form>
                                                                </td>
                              
                                
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
    
                                            </div>
                                        </div>


                                    </div>
                                </div>

                            </main>

                            <script>
                                    // تابع برای نمایش صفحه مورد نظر
                                    function showPage(pageId) {
                                        // مخفی کردن همه صفحات
                                        const pages = document.querySelectorAll('.page-content');
                                        pages.forEach(page => {
                                            page.classList.remove('active');
                                        });

                                        // نمایش صفحه انتخاب شده
                                        document.getElementById(pageId).classList.add('active');

                                        // به روزرسانی Title صفحه
                                        const pageTitle = document.getElementById('page-title');
                                        const breadcrumb = document.getElementById('breadcrumb');

                                        switch(pageId) {
                                            case 'dashboard':
                                                pageTitle.textContent = 'Overview';
                                                breadcrumb.innerHTML = '<span>Home</span> / <span>Overview</span>';
                                                break;
                                            case 'add-property':
                                                pageTitle.textContent = 'Add property';
                                                breadcrumb.innerHTML = '<span>Home</span> / <span>Add property</span>';
                                                break;
                                            case 'manage-properties':
                                                pageTitle.textContent = 'Property management';
                                                breadcrumb.innerHTML = '<span>Home</span> / <span>Property management</span>';
                                                break;
                                            case 'manage-admins':
                                                pageTitle.textContent = 'Manage admins';
                                                breadcrumb.innerHTML = '<span>Home</span> / <span>Manage admins</span>';
                                                break;
                                            case 'users':
                                                pageTitle.textContent = 'Manage users';
                                                breadcrumb.innerHTML = '<span>Home</span> / <span>Manage users</span>';
                                                break;
                                            case 'settings':
                                                pageTitle.textContent = 'System settings';
                                                breadcrumb.innerHTML = '<span>Home</span> / <span>Settings</span>';
                                                break;
                                        }

                                        // به روزرسانی وضعیت فعال در منو
                                        const menuItems = document.querySelectorAll('.sidebar-menu a');
                                        menuItems.forEach(item => {
                                            item.classList.remove('active');
                                        });

                                        // پیدا کردن آیتم منوی مربوطه و فعال کردن آن
                                        const currentPageItem = Array.from(menuItems).find(item => {
                                            return item.getAttribute('onclick').includes(pageId);
                                        });

                                        if (currentPageItem) {
                                            currentPageItem.classList.add('active');
                                        }

                                        return false;
                                    }

                                    function openEditAdminModal(button) {
                                        const modal = document.getElementById('edit-admin-modal');
                                        document.getElementById('edit-admin-id').value = button.dataset.adminId || '';
                                        document.getElementById('edit-admin-username').value = button.dataset.adminUsername || '';
                                        document.getElementById('edit-admin-password').value = button.dataset.adminPassword || '';
                                        modal.classList.add('active');
                                        modal.setAttribute('aria-hidden', 'false');
                                        document.getElementById('edit-admin-username').focus();
                                    }

                                    function closeEditAdminModal() {
                                        const modal = document.getElementById('edit-admin-modal');
                                        modal.classList.remove('active');
                                        modal.setAttribute('aria-hidden', 'true');
                                    }

                                    document.getElementById('edit-admin-modal').addEventListener('click', function(e) {
                                        if (e.target === this) {
                                            closeEditAdminModal();
                                        }
                                    });

                                    document.addEventListener('keydown', function(e) {
                                        if (e.key === 'Escape') {
                                            closeEditAdminModal();
                                        }
                                    });

                                    // Adminیت Send فرم‌ها
                                    document.getElementById('property-form').addEventListener('submit', function(e) {
                                        e.preventDefault();
                                        alert('Property added successfully!');
                                        this.reset();
                                    });





                                    // عملکرد خروج از حساب
                                    function logout() {
                                        if (confirm('Sign out of this account?')) {
                                            alert('You have signed out.');
                                            // در اینجا می‌توانید User را به صفحه Sign in هدایت کنید
                                            // window.location.href = 'login.html';
                                        }
                                    }
                            </script>
                        </body>
                    </html>
