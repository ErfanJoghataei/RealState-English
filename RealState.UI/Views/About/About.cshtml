@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/About/about.css" rel="stylesheet" />
}

<div class="about-container">
    <div class="about-header">
        <h1>About us</h1>
        <p>We help people buy, sell, and rent homes with clear advice, local knowledge, and a personal approach.</p>
    </div>

    <div class="about-content">
        <div class="about-card">
            <h2>Our story</h2>
            <p>Our team has worked in real estate since 2011, helping more than 2,000 clients find the right property or buyer.</p>
            <p>We pair current market knowledge with dedicated advisers to make each decision easier.</p>
        </div>

        <div class="about-card">
            <h2>Our mission</h2>
            <p>Our mission is to make property decisions clear and dependable, so clients can move forward with confidence.</p>
            <p>Honesty and client satisfaction shape every recommendation we make.</p>
        </div>
    </div>

    <h2 style="text-align: center; color: var(--secondary); margin-bottom: 1rem; margin-top: 2rem;">Why work with us</h2>

    <div class="features-grid">
        <div class="feature-item">
            <div class="feature-icon">
                <i class="fas fa-lightbulb"></i>
            </div>
            <div class="feature-content">
                <h3>Personal guidance</h3>
                <p>Guidance for buying, selling, or renting based on your needs and budget.</p>
            </div>
        </div>

        <div class="feature-item">
            <div class="feature-icon">
                <i class="fas fa-code"></i>
            </div>
            <div class="feature-content">
                <h3>Broad property selection</h3>
                <p>Access to a broad selection of verified listings across the city.</p>
            </div>
        </div>

        <div class="feature-item">
            <div class="feature-icon">
                <i class="fas fa-searchengin"></i>
            </div>
            <div class="feature-content">
                <h3>Clear agreements</h3>
                <p>Clear paperwork and legal guidance through each transaction.</p>
            </div>
        </div>
    </div>

    <div class="cta-section">
        <h2>Start your search</h2>
        <p>Contact us for a conversation about your next move.</p>
        <a href="tel:09123907459" class="cta-button">Contact us</a>
    </div>
</div>
