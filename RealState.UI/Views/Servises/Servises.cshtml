@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="/css/Servises/Servises.css" rel="stylesheet" />
}

<!-- بخش خدمات -->
    <div class="services-container">
        <div class="services-header">
            <h1>Property services</h1>
            <p>Experienced support for buying, selling, renting, and caring for property.</p>
        </div>

        <div class="services-grid">
            <!-- خدمت ۱ -->
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-home"></i>
                </div>
                <h3>Buying and selling</h3>
                <p>Support for residential and commercial property purchases and sales, from search to closing.</p>

                <div class="service-features">
                    <h4>What's included</h4>
                    <ul class="feature-list">
                        <li><i class="fas fa-check"></i> Market pricing</li>
                        <li><i class="fas fa-check"></i> Property viewings</li>
                        <li><i class="fas fa-check"></i> Expert advice</li>
                        <li><i class="fas fa-check"></i> Transaction support</li>
                    </ul>
                </div>
            </div>

            <!-- خدمت ۲ -->
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h3>Rentals</h3>
                <p>Rental support with clear agreements and guidance throughout the lease.</p>

                <div class="service-features">
                    <h4>What's included</h4>
                    <ul class="feature-list">
                        <li><i class="fas fa-check"></i> Clear lease agreements</li>
                        <li><i class="fas fa-check"></i> Property inspections</li>
                        <li><i class="fas fa-check"></i> Rent collection support</li>
                        <li><i class="fas fa-check"></i> Dispute assistance</li>
                    </ul>
                </div>
            </div>

            <!-- خدمت ۳ -->
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-building"></i>
                </div>
                <h3>Investment advice</h3>
                <p>Research and practical guidance for thoughtful property investment decisions.</p>

                <div class="service-features">
                    <h4>What's included</h4>
                    <ul class="feature-list">
                        <li><i class="fas fa-check"></i> Market analysis</li>
                        <li><i class="fas fa-check"></i> Opportunity research</li>
                        <li><i class="fas fa-check"></i> Market outlook</li>
                        <li><i class="fas fa-check"></i> Portfolio guidance</li>
                    </ul>
                </div>
            </div>

            <!-- خدمت ۴ -->
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-file-contract"></i>
                </div>
                <h3>Legal guidance</h3>
                <p>Legal guidance for property transactions and related disputes.</p>

                <div class="service-features">
                    <h4>What's included</h4>
                    <ul class="feature-list">
                        <li><i class="fas fa-check"></i> Title review</li>
                        <li><i class="fas fa-check"></i> Tailored agreements</li>
                        <li><i class="fas fa-check"></i> Case follow-up</li>
                        <li><i class="fas fa-check"></i> Regulatory guidance</li>
                    </ul>
                </div>
            </div>

            <!-- خدمت ۵ -->
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h3>Renovation</h3>
                <p>Renovation planning and improvements that help properties work harder for their owners.</p>

                <div class="service-features">
                    <h4>What's included</h4>
                    <ul class="feature-list">
                        <li><i class="fas fa-check"></i> Interior design</li>
                        <li><i class="fas fa-check"></i> Project oversight</li>
                        <li><i class="fas fa-check"></i> Quality materials</li>
                        <li><i class="fas fa-check"></i> Project management</li>
                    </ul>
                </div>
            </div>

            <!-- خدمت ۶ -->
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-handshake"></i>
                </div>
                <h3>Property management</h3>
                <p>Practical property management for owners who need reliable day-to-day support.</p>

                <div class="service-features">
                    <h4>What's included</h4>
                    <ul class="feature-list">
                        <li><i class="fas fa-check"></i> Ongoing maintenance</li>
                        <li><i class="fas fa-check"></i> Property finances</li>
                        <li><i class="fas fa-check"></i> Tenant communication</li>
                        <li><i class="fas fa-check"></i> Regular reporting</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- فرآیند کار -->
        <div class="process-section">
            <div class="process-header">
                <h2>How we work</h2>
                <p>A simple process from first conversation to delivery.</p>
            </div>

            <div class="process-steps">
                <div class="process-step">
                    <h3>First contact</h3>
                    <p>Tell us what you need, and an adviser will get in touch.</p>
                </div>

                <div class="process-step">
                    <h3>Needs review</h3>
                    <p>We review your goals, constraints, and options together.</p>
                </div>

                <div class="process-step">
                    <h3>Agreement</h3>
                    <p>Once the scope is agreed, we document the terms clearly.</p>
                </div>

                <div class="process-step">
                    <h3>Delivery</h3>
                    <p>Our team carries out the agreed work and keeps you informed.</p>
                </div>
            </div>
        </div>

        <!-- دعوت به اقدام -->
        <div class="cta-section">
            <h2>Ready when you are</h2>
            <p>Let our team help you manage the details of your property with confidence.</p>
            <a href="tel:09123907459" class="cta-button">Request a consultation</a>
        </div>
    </div>


